import os
from google import genai
from google.genai import types

def analyze_privacy_text(policy_text: str):
    client = genai.Client()
    system_instruction = (
        "You are ConsentGuard AI, ..."
    )
    config = types.GenerateContentConfig(
        system_instruction=system_instruction,
        temperature=0.2,
    )
    print("Processing text through ConsentGuard AI Engine...")
    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=policy_text,
        config=config
    )
    return response.text

if __name__ == "__main__":
    sample_clause = (
        "We automatically collect your precise geolocation information, ..."
    )
    analysis_result = analyze_privacy_text(sample_clause)
    print("\n --- ANALYSIS REPORT ---")
    print(analysis_result)
