{
  "manifest_version": 3,
  "name": "ConsentGuard-AI",
  "version": "1.0.0",
  "description": "Real-time, pre-consent digital privacy guardian that intercepts and analyzes privacy agreements before you click accept.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["content.css", "popup.html", "popup.css", "popup.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
